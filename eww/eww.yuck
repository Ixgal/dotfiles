(defwindow wallpaper-menu
  :monitor "DP-1"
  :geometry (geometry
             :x "0px"
             :y "0px"
             :anchor "top right"
             :width "542px"
             :height "66px")
  :stacking "overlay"
  :windowtype "normal"
  :focusable "none"
  (box :class "wm" :orientation "h" :spacing 4
    (for w in wm_view
      (button :class {wm_sel == w.path ? "wc a" : "wc"}
              :onclick "${w.cmd}"
        (overlay
          (image :path "${w.thumb}" :image-width 74 :image-height 46)
          (box :class "d" :halign "center" :valign "end" :visible {wm_sel == w.path} "●"))))
    (button :class "wx" :onclick "/home/jairo/.config/eww/scripts/toggle_wallpaper_menu.sh" "✕")))
