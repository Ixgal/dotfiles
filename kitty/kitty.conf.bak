# Purple transparent terminal theme
background_opacity 0.85

# Cursor
cursor #c084fc
cursor_text_color #1a1035
cursor_shape beam
cursor_blink_interval 0.5

# Bell
enable_audio_bell no
visual_bell_duration 0.0

# Scrollback
scrollback_lines 10000

# Mouse
copy_on_select clipboard
hide_mouse_cursor_when_typing yes

# Window
window_padding_width 0
window_margin_width 0
single_window_margin_width -1
inactive_border_color #3b2870
active_border_color #7c3aed
inactive_text_alpha 0.7

# Tab bar
tab_bar_style powerline
tab_powerline_style slanted
active_tab_foreground #ffffff
active_tab_background #7c3aed
inactive_tab_foreground #a78bfa
inactive_tab_background #1e1040

# Colors - transparent purple palette
background #1a1035
foreground #ffffff
selection_background #7c3aed
selection_foreground #ffffff
cursor_text_color #1a1035

# ANSI palette
color0  #1a1035
color1  #f472b6
color2  #86efac
color3  #fcd34d
color4  #818cf8
color5  #c084fc
color6  #67e8f9
color7  #e2d9f3
color8  #4c1d95
color9  #f9a8d4
color10 #bbf7d0
color11 #fde68a
color12 #a5b4fc
color13 #d8b4fe
color14 #a5f3fc
color15 #f5f3ff