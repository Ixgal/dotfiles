/* Mismo cristal que kitty: velo morado claro casi transparente.
   Sin blur del compositor no hay fondo que oscurezca el wallpaper,
   asi que la legibilidad la sostiene el text-shadow, no el fondo. */
* {
    font-family: "Symbols Nerd Font", "Noto Sans", sans-serif;
    font-size: 13px;
    border: none;
    border-radius: 0;
    min-height: 0;
    text-shadow: 0 1px 3px rgba(12, 6, 28, 0.95);
}

window#waybar {
    background: linear-gradient(180deg, rgba(179, 157, 219, 0.20), rgba(179, 157, 219, 0.10));
    border: 1px solid rgba(216, 180, 254, 0.35);
    border-radius: 14px;
    color: #ffffff;
}

window#waybar.hidden {
    opacity: 0.15;
}

tooltip {
    background: rgba(46, 32, 82, 0.97);
    border: 1px solid rgba(192, 132, 252, 0.30);
    border-radius: 10px;
    color: #ffffff;
}

tooltip label {
    color: #ffffff;
}

.modules-left, .modules-right {
    margin: 0 3px;
}

button, .module {
    border-radius: 9px;
    padding: 0 7px;
    margin: 2px 1px;
    background-color: rgba(216, 180, 254, 0.10);
    transition: background-color 0.2s ease, color 0.2s ease,
                box-shadow 0.2s ease;
}

button:hover {
    background-color: rgba(216, 180, 254, 0.24);
}

/* ---- Workspaces (navegación) ---- */
#workspaces {
    background: rgba(216, 180, 254, 0.10);
    border-radius: 9px;
    padding: 0 3px;
}

#workspaces button {
    background: transparent;
    padding: 0 6px;
    color: #cfc4ea;
}

#workspaces button:hover {
    background: rgba(192, 132, 252, 0.12);
    color: #ffffff;
}

#workspaces button.active,
#workspaces button.focused {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.95), rgba(192, 132, 252, 0.70));
    color: #ffffff;
    box-shadow: 0 0 12px rgba(139, 92, 246, 0.50);
}

#workspaces button.urgent {
    background-color: #ef4444;
    color: #ffffff;
    box-shadow: 0 0 12px rgba(239, 68, 68, 0.5);
}

/* ---- Red ---- */
#custom-network.connected {
    background-color: rgba(139, 92, 246, 0.20);
    color: #e4d9ff;
}

#custom-network.connected:hover {
    background-color: rgba(139, 92, 246, 0.36);
}

#custom-network.disconnected,
#custom-network.empty {
    background-color: rgba(239, 68, 68, 0.20);
    color: #f87171;
}

/* ---- Monitor ---- */
#custom-monitor {
    background-color: rgba(139, 92, 246, 0.18);
    color: #ddc9ff;
}

#custom-monitor:hover {
    background-color: rgba(139, 92, 246, 0.36);
    color: #e4d9ff;
}

/* ---- Audio ---- */
#pulseaudio {
    background-color: rgba(217, 70, 239, 0.18);
    color: #e879f9;
}

#pulseaudio.muted {
    background-color: rgba(239, 68, 68, 0.22);
    color: #f87171;
}

/* ---- Spotify ---- */
#custom-media {
    background-color: rgba(139, 92, 246, 0.20);
    color: #e4d9ff;
    font-weight: 600;
}

#custom-media.playing { color: #a5b4fc; }

#custom-media.paused {
    background-color: rgba(139, 92, 246, 0.12);
    color: #cfc4ea;
}

#custom-media:hover {
    background-color: rgba(139, 92, 246, 0.38);
    color: #ffffff;
}

/* ---- Sistema (grupo colapsable) ---- */
#system {
    background: rgba(216, 180, 254, 0.10);
    border-radius: 9px;
    margin: 2px 1px;
}

#system #custom-system {
    background: transparent;
    color: #e3ccff;
    padding: 0 8px;
}

#system #custom-system:hover {
    background: rgba(168, 85, 247, 0.20);
}

#system #cpu,
#system #memory,
#system #disk,
#system #temperature {
    background: rgba(192, 132, 252, 0.10);
    color: #e4d9ff;
}

#system .system-child {
    background: rgba(192, 132, 252, 0.10);
    color: #e4d9ff;
}

/* ---- Brillo ---- */
#backlight {
    background-color: rgba(148, 87, 240, 0.18);
    color: #dcc4ff;
}

/* ---- Batería ---- */
#battery {
    background-color: rgba(34, 197, 94, 0.16);
    color: #4ade80;
}

#battery.warning {
    background-color: rgba(250, 204, 21, 0.20);
    color: #facc15;
}

#battery.critical:not(.charging) {
    background-color: rgba(239, 68, 68, 0.30);
    color: #f87171;
    animation: blink 0.6s steps(12) infinite alternate;
}

@keyframes blink {
    to { background-color: #ef4444; color: #ffffff; }
}

/* ---- Reloj ---- */
#clock {
    font-weight: 700;
    background: rgba(192, 132, 252, 0.08);
    color: #f5f3ff;
    padding: 0 10px;
}

/* ---- Bandeja ---- */
#tray {
    background-color: rgba(216, 180, 254, 0.10);
    border-radius: 9px;
    padding: 0 6px;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    background-color: #ef4444;
    border-radius: 8px;
}

/* ---- Apagado ---- */
#custom-power {
    background-color: rgba(239, 68, 68, 0.20);
    color: #f87171;
    font-size: 15px;
    padding: 0 11px;
}

#custom-power:hover {
    background-color: #ef4444;
    color: #ffffff;
    box-shadow: 0 0 12px rgba(239, 68, 68, 0.5);
}